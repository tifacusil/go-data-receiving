# Example environment for the data-receiving Go service.
# Copy to .env (gitignored) for local runs. Secrets (RabbitMQ password, Consul
# token) NEVER go here — on servers they live in /etc/data-receiving/secrets.

# Core
RECEIVER__PORT=5000
RECEIVER__DLXPATH=./dlx
RECEIVER__OUTPUTMODE=rabbitmq
RECEIVER__OUTPUTFILEPATH=./output

# Redis — include the password inline: host:port,password=<secret>
RECEIVER__REDIS__CONNECTIONSTRING=localhost:6379,password=<Redis password>
RECEIVER__REDIS__BUFFERTLTHOURS=24
RECEIVER__REDIS__RETRYINTERVALSECONDS=30
RECEIVER__REDIS__RETRYMINAGEMINUTES=2

# RabbitMQ (password from secrets file, not here)
RECEIVER__RABBITMQ__HOST=localhost
RECEIVER__RABBITMQ__PORT=5672
RECEIVER__RABBITMQ__VIRTUALHOST=/
RECEIVER__RABBITMQ__USERNAME=data_receiving
RECEIVER__RABBITMQ__EXCHANGE=sensors.raw
RECEIVER__RABBITMQ__CONFIRMTIMEOUTSECONDS=5

# Consul (token from secrets file, not here)
RECEIVER__CONSUL__ADDRESS=http://localhost:8500
RECEIVER__CONSUL__INSTANCEID=data-receiving-01
RECEIVER__CONSUL__HEALTHPORT=8080
RECEIVER__CONSUL__SERVICEVERSION=1.0.0
RECEIVER__CONSUL__ENVIRONMENT=prod
# Host Consul uses to reach /health. localhost works when the Consul agent is
# on the same host (Wave 1). With a containerized Consul, set this to the
# service's reachable address (container name or host IP).
RECEIVER__CONSUL__HEALTHCHECKHOST=localhost
