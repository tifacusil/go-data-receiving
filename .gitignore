# Binaries — anchored to repo root so they don't match the cmd/data-receiving/ source dir
/bin/
/dist/
/data-receiving
/data-receiving.exe

# Test artifacts
*.out
coverage.*

# Generated pact files (regenerated by `make test-pact`; UUID matcher makes them
# non-deterministic, so they are published to a broker rather than committed).
/test/pact/pacts/
/test/pact/logs/

# Runtime output dirs (mirror of C# .gitignore: dlx/, output/)
/dlx/
/output/

# Secrets — never commit. Real values live in /etc/data-receiving/secrets
.env

# IDE / OS
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
